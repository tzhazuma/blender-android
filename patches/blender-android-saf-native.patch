+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup creator
+ *
+ * Storage Access Framework bridge, native side.
+ *
+ * The Java half lives in BlenderActivity.java; this declares the three calls the rest of Blender
+ * may use. Everything here is a no-op or an empty result on non-Android builds, so call sites do
+ * not need their own #ifdef.
+ *
+ * Where these belong: the plan is to intercept the file browser's confirm
+ * (`file_select_exec`, source/blender/editors/space_file/file_ops.cc:576) so that on Android the
+ * system picker supplies the path instead of Blender's own browser. Import/export and the render
+ * output path go through the same operator family, so one hook covers all four cases the port
+ * needs (open, import, export, output).
+ *
+ * Nothing calls these yet -- see STATUS.md round 64.
+ */
+
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace blender {
+
+/**
+ * Show the system open picker and return the real paths the user chose.
+ *
+ * The documents are copied into the app's private storage first, so the returned paths stay valid
+ * after Android revokes the temporary URI grant. Empty when the user cancelled or the bridge is
+ * unavailable (including every non-Android build).
+ */
+std::vector<std::string> android_saf_pick_open();
+
+/**
+ * Ask where a finished file should land. \a suggested_name is shown as the default name.
+ *
+ * \return true when a destination was chosen; \ref android_saf_publish then delivers the file.
+ */
+bool android_saf_pick_save(const char *suggested_name);
+
+/** Copy an already written file to the destination \ref android_saf_pick_save returned. */
+bool android_saf_publish(const char *path);
+
+}  // namespace blender
