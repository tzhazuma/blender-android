+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup creator
+ *
+ * Non-Android stand-ins for the Storage Access Framework bridge, so call sites in shared editor
+ * code do not need their own #ifdef __ANDROID__. On desktop these answer exactly as "the system
+ * picker is unavailable", which is the behaviour an Android-only capability should have.
+ */
+
+#ifndef __ANDROID__
+
+#  include "creator_android_saf.hh"
+
+namespace blender {
+
+std::vector<std::string> android_saf_pick_open()
+{
+  return {};
+}
+
+bool android_saf_pick_save(const char * /*suggested_name*/)
+{
+  return false;
+}
+
+bool android_saf_publish(const char * /*path*/)
+{
+  return false;
+}
+
+}  // namespace blender
+
+#endif /* !__ANDROID__ */
