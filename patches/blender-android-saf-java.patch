+    /* ---------------------------------------------------------------------------------------
+     * Storage Access Framework bridge.
+     *
+     * Blender works entirely in POSIX paths: BLI_file, the file browser, the render output path
+     * and every importer/exporter open() a string. Android hands back content:// URIs, which those
+     * cannot use. So the pickers below copy each picked document into filesDir/incoming/ (or, for
+     * saving, hand Blender a scratch path in filesDir/outgoing/ and copy it out afterwards) and the
+     * native side only ever sees real paths.
+     *
+     * Results travel through the filesystem -- filesDir/saf-manifest.txt, one path per line -- so
+     * the JNI surface stays at the handful of methods the native side actually calls, and large
+     * selections never have to be marshalled as Java arrays.
+     *
+     * The native side (creator_android_saf.cc) calls safPickOpen/safPickSave, then polls
+     * safIsDone/safSaveDone, then reads the manifest or calls safPublish.
+     * --------------------------------------------------------------------------------------- */
+
+    private static final int REQ_SAF_OPEN = 0x5AF11;
+    private static final int REQ_SAF_SAVE = 0x5AF12;
+    private static final String SAF_MANIFEST = "saf-manifest.txt";
+
+    private volatile boolean safImportDone = true;
+    private volatile boolean safSaveDone = true;
+    private volatile boolean safHasSaveUri = false;
+    private Uri safSaveUri = null;
+
+    /** ACTION_OPEN_DOCUMENT, any number of files. Contents are copied into filesDir/incoming/. */
+    public void safPickOpen() {
+        safImportDone = false;
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("*/*");
+        intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true);
+        try {
+            startActivityForResult(intent, REQ_SAF_OPEN);
+        } catch (Exception e) {
+            Log.w(LOG_TAG, "no activity can handle ACTION_OPEN_DOCUMENT", e);
+            safImportDone = true;
+        }
+    }
+
+    /** True once the open picker has finished and filesDir/saf-manifest.txt is written. */
+    public boolean safIsDone() {
+        return safImportDone;
+    }
+
+    /** ACTION_CREATE_DOCUMENT. The chosen URI stays here until safPublish spends it. */
+    public void safPickSave(String suggestedName) {
+        safSaveDone = false;
+        safHasSaveUri = false;
+        safSaveUri = null;
+        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("*/*");
+        intent.putExtra(Intent.EXTRA_TITLE, suggestedName);
+        try {
+            startActivityForResult(intent, REQ_SAF_SAVE);
+        } catch (Exception e) {
+            Log.w(LOG_TAG, "no activity can handle ACTION_CREATE_DOCUMENT", e);
+            safSaveDone = true;
+        }
+    }
+
+    public boolean safSaveDone() {
+        return safSaveDone;
+    }
+
+    public boolean safHasSaveUri() {
+        return safHasSaveUri;
+    }
+
+    /** Copy a finished file (Blender wrote it in filesDir/outgoing/) to the chosen destination. */
+    public boolean safPublish(String path) {
+        Uri destination = safSaveUri;
+        if (destination == null) {
+            Log.w(LOG_TAG, "safPublish with no destination");
+            return false;
+        }
+        File source = new File(path);
+        if (!source.isFile()) {
+            Log.w(LOG_TAG, "safPublish: not a file: " + path);
+            return false;
+        }
+        try (InputStream in = new java.io.FileInputStream(source);
+             java.io.OutputStream out = getContentResolver().openOutputStream(destination, "wt")) {
+            if (out == null) {
+                Log.w(LOG_TAG, "safPublish: openOutputStream returned null");
+                return false;
+            }
+            byte[] buffer = new byte[256 * 1024];
+            int read;
+            long total = 0;
+            while ((read = in.read(buffer)) > 0) {
+                out.write(buffer, 0, read);
+                total += read;
+            }
+            out.flush();
+            Log.i(LOG_TAG, "SAF: published " + total + " bytes to " + destination);
+            return true;
+        } catch (IOException e) {
+            Log.w(LOG_TAG, "SAF: safPublish failed", e);
+            return false;
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == REQ_SAF_OPEN) {
+            try {
+                writeSafManifest(resultCode == Activity.RESULT_OK ? data : null);
+            } catch (Throwable t) {
+                Log.w(LOG_TAG, "SAF: import failed", t);
+            } finally {
+                safImportDone = true;
+            }
+        } else if (requestCode == REQ_SAF_SAVE) {
+            try {
+                if (resultCode == Activity.RESULT_OK && data != null && data.getData() != null) {
+                    safSaveUri = data.getData();
+                    try {
+                        getContentResolver().takePersistableUriPermission(
+                                safSaveUri, Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+                    } catch (SecurityException ignored) {
+                        /* One-shot grant is enough for the immediate publish. */
+                    }
+                    safHasSaveUri = true;
+                    Log.i(LOG_TAG, "SAF: save destination " + safSaveUri);
+                } else {
+                    Log.i(LOG_TAG, "SAF: save cancelled");
+                }
+            } finally {
+                safSaveDone = true;
+            }
+        }
     }
+
+    /**
+     * Copy whatever the open picker returned into filesDir/incoming and record the real paths.
+     *
+     * Blender is given real files rather than URIs because every importer and every file browser
+     * action takes a POSIX path. Two documents with the same name from different folders both get
+     * copied -- a numeric suffix keeps them apart instead of silently dropping one.
+     */
+    private void writeSafManifest(Intent data) throws IOException {
+        File manifest = new File(getFilesDir(), SAF_MANIFEST);
+        if (data == null) {
+            try (java.io.FileOutputStream out = new java.io.FileOutputStream(manifest, false)) {
+                /* Empty, so a cancelled pick cannot re-import the previous selection. */
+            }
+            Log.i(LOG_TAG, "SAF: import cancelled; manifest cleared");
+            return;
+        }
+
+        ArrayList<Uri> uris = new ArrayList<>();
+        android.content.ClipData clip = data.getClipData();
+        if (clip != null) {
+            for (int i = 0; i < clip.getItemCount(); i++) {
+                Uri uri = clip.getItemAt(i).getUri();
+                if (uri != null) {
+                    uris.add(uri);
+                }
+            }
+        } else if (data.getData() != null) {
+            uris.add(data.getData());
+        }
+
+        File dir = new File(getFilesDir(), "incoming");
+        if (!dir.isDirectory() && !dir.mkdirs()) {
+            Log.w(LOG_TAG, "SAF: could not create " + dir);
+            return;
+        }
+
+        StringBuilder lines = new StringBuilder();
+        for (Uri uri : uris) {
+            try {
+                getContentResolver().takePersistableUriPermission(
+                        uri, Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            } catch (SecurityException ignored) {
+                /* The copy below happens while the one-shot grant is live. */
+            }
+            File target = uniqueTarget(dir, safDisplayName(uri));
+            try (InputStream in = getContentResolver().openInputStream(uri);
+                 java.io.OutputStream out = new java.io.FileOutputStream(target)) {
+                if (in == null) {
+                    Log.w(LOG_TAG, "SAF: openInputStream returned null for " + uri);
+                    continue;
+                }
+                byte[] buffer = new byte[256 * 1024];
+                int read;
+                while ((read = in.read(buffer)) > 0) {
+                    out.write(buffer, 0, read);
+                }
+            } catch (IOException e) {
+                Log.w(LOG_TAG, "SAF: could not copy " + uri, e);
+                continue;
+            }
+            lines.append(target.getAbsolutePath()).append('\n');
+            Log.i(LOG_TAG, "SAF: imported " + uri + " -> " + target);
+        }
+        try (java.io.FileOutputStream out = new java.io.FileOutputStream(manifest, false)) {
+            out.write(lines.toString().getBytes(StandardCharsets.UTF_8));
+        }
+        Log.i(LOG_TAG, "SAF: manifest written, " + uris.size() + " candidate(s)");
+    }
+
+    private static File uniqueTarget(File dir, String name) {
+        File target = new File(dir, name);
+        if (!target.exists()) {
+            return target;
+        }
+        int dot = name.lastIndexOf('.');
+        String stem = dot > 0 ? name.substring(0, dot) : name;
+        String suffix = dot > 0 ? name.substring(dot) : "";
+        for (int n = 2; ; n++) {
+            target = new File(dir, stem + " (" + n + ")" + suffix);
+            if (!target.exists()) {
+                return target;
+            }
+        }
+    }
+
+    private String safDisplayName(Uri uri) {
+        String name = null;
+        try {
+            name = DocumentsContract.getDocumentId(uri);
+            int slash = name.lastIndexOf('/');
+            if (slash >= 0) {
+                name = name.substring(slash + 1);
+            }
+            int colon = name.indexOf(':');
+            if (colon >= 0) {
+                name = name.substring(colon + 1);
+            }
+        } catch (Throwable ignored) {
+            /* Not a document URI; fall through to the path segment. */
+        }
+        if (name == null || name.isEmpty()) {
+            name = uri.getLastPathSegment();
+        }
+        if (name == null || name.isEmpty()) {
+            name = "imported";
+        }
+        return name.replace('/', '_');
+    }
 }
