--- a/source/blender/blenkernel/intern/appdir.cc
+++ b/source/blender/blenkernel/intern/appdir.cc
@@ -138,6 +138,22 @@
 
 const char *BKE_appdir_folder_default()
 {
+#ifdef __ANDROID__
+  /* android-port: an Android app has no user visible `$HOME` (`HOME` points into the
+   * app private data directory, which is not reachable with a file manager), the closest
+   * equivalent of "the user's documents" is the emulated shared storage.
+   * Prefer a directory that is also writable, so "Save As" works out of the box. */
+  static const char *android_default_dirs[] = {
+      "/storage/emulated/0/Download",
+      "/storage/emulated/0/Documents",
+      "/storage/emulated/0",
+  };
+  for (const char *dir : android_default_dirs) {
+    if (BLI_is_dir(dir)) {
+      return dir;
+    }
+  }
+#endif
 #ifndef WIN32
   return BLI_dir_home();
 #else  /* Windows */
